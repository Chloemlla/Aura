<?xml version="1.0" encoding="utf-8"?>
<!--
  Allowlist, not blacklist: any <include> disables the platform default of backing up
  every standard directory, so anything not listed here (Room DB, DataStore, all other
  sharedprefs, cached media) never leaves the device. A new preferences file therefore
  defaults to "not backed up" instead of silently opting in.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="freevibe_locale.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="freevibe_locale.xml" />
    </device-transfer>
</data-extraction-rules>
