      "id": "play-app-signing-console",
      "status": "unknown",
      "reason": "Requires release-owner access to Play Console App integrity."
    },
    {
      "id": "github-release-publication",
      "status": "unknown",
      "reason": "Requires network access and the release owner's GitHub publication state."
    },
    {
