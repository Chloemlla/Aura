{
  "schemaVersion": 1,
  "policyKind": "accessibilityReleaseGate",
  "status": "releaseGateReadyManualEvidenceRequired",
  "automatedGate": {
    "instrumentedTest": "app/src/androidTest/java/com/freevibe/ui/accessibility/AccessibilityReleaseGateTest.kt",
    "requiredApi": "enableAccessibilityChecks",
    "requiredDependencies": [
      "androidx.compose.ui:ui-test-junit4",
      "androidx.compose.ui:ui-test-junit4-accessibility"
    ],
    "executedSurfaces": [
      {
        "id": "wallpapers-grid",
        "surface": "Wallpapers feed success state with search, local cache status, and wallpaper cards",
        "scenario": "ProductionRouteScenario.WallpapersGridSuccess",
        "assertionResource": "R.string.nav_wallpapers"
      },
      {
        "id": "wallpapers-offline",
        "surface": "Wallpapers offline/local empty state with provider failure messaging",
        "scenario": "ProductionRouteScenario.WallpapersOfflineEmpty",
        "assertionResource": "R.string.wallpapers_empty_default_title"
      },
      {
        "id": "sounds-detail",
        "surface": "Sound detail state with waveform, playback controls, metadata, and cache status",
        "scenario": "ProductionRouteScenario.SoundDetailReady",
        "assertionResource": "R.string.nav_sounds"
      },
      {
        "id": "settings-diagnostics",
        "surface": "Settings diagnostics/provider-disabled state at large font scale",
        "scenario": "ProductionRouteScenario.SettingsProviderDisabled",
        "assertionResource": "R.string.nav_settings"
      },
      {
        "id": "video-wallpapers",
        "surface": "Video wallpapers degraded-provider state with preview metadata",
        "scenario": "ProductionRouteScenario.VideoWallpapersError",
        "assertionResource": "R.string.nav_videos"
      },
      {
        "id": "wallpaper-editor",
        "surface": "Wallpaper editor loading/recovery state with tool controls",
        "scenario": "ProductionRouteScenario.WallpaperEditorLoading",
        "assertionResource": "R.string.editor_wallpaper_title"
      }
    ],
    "verifyCommand": "./gradlew :app:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.freevibe.ui.accessibility.AccessibilityReleaseGateTest"
  },
  "manualScenarios": [
    {
      "id": "wallpapers-feed-detail",
      "surface": "Wallpapers feed, filters, Wallpaper Detail, apply sheet",
      "checks": ["TalkBack traversal order", "action labels", "favorite/vote state", "dark and light themes"]
    },
    {
      "id": "video-wallpapers",
      "surface": "Video wallpapers feed, preview, crop, live-wallpaper picker",
      "checks": ["preview state", "apply state", "crop controls", "live-wallpaper picker labels"]
    },
    {
      "id": "sounds-editor",
      "surface": "Sounds feed, Sound Detail, Sound Editor",
      "checks": ["playback progress", "waveform range", "apply buttons", "record/upload disclosure"]
    },
    {
      "id": "settings-diagnostics",
      "surface": "Settings, privacy, diagnostics, background work, provider controls",
      "checks": ["switch labels", "dialog headings", "error states", "support bundle actions"]
    },
    {
      "id": "adaptive-access",
      "surface": "Primary app flows at 200 percent font, high contrast, dark/light themes",
      "checks": ["no clipped text", "48dp touch targets", "contrast", "scroll reachability"]
    },
    {
      "id": "widget-entrypoints",
      "surface": "Home widget and live-wallpaper picker metadata",
      "checks": ["spoken labels", "disabled/error state", "large display size"]
    }
  ],
  "releaseRequirement": "Run the automated accessibility test and complete every manual scenario, or record an explicit release waiver with reason and owner.",
  "sourceUrls": [
    "https://developer.android.com/develop/ui/compose/accessibility/testing",
    "https://developer.android.com/guide/topics/ui/accessibility/testing",
    "https://developer.android.com/guide/topics/ui/accessibility/apps"
  ]
}
